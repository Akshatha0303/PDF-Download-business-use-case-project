<apex:page
  controller="InvoicePDFController"
  renderAs="pdf"
  applyBodyTag="false"
  standardStylesheets="false"
  showHeader="false"
  sidebar="false"
>
  <html>
    <head>
      <style type="text/css">
        body {
          font-family: Arial, Helvetica, sans-serif;
          font-size: 12px;
          color: #181818;
          margin: 24px;
        }
        h1 {
          font-size: 22px;
          margin-bottom: 4px;
        }
        .subtitle {
          color: #444;
          margin-bottom: 24px;
        }
        .meta-table {
          width: 100%;
          margin-bottom: 24px;
        }
        .meta-table td {
          padding: 4px 8px 4px 0;
          vertical-align: top;
        }
        .meta-label {
          font-weight: bold;
          width: 140px;
        }
        table.line-items {
          width: 100%;
          border-collapse: collapse;
          margin-top: 8px;
        }
        table.line-items th,
        table.line-items td {
          border: 1px solid #d8dde6;
          padding: 8px;
          text-align: left;
        }
        table.line-items th {
          background-color: #f3f3f3;
          font-weight: bold;
        }
        .total-row {
          margin-top: 16px;
          text-align: right;
          font-size: 14px;
          font-weight: bold;
        }
        .empty-message {
          color: #c23934;
        }
      </style>
    </head>
    <body>
      <apex:outputPanel rendered="{!hasInvoice}">
        <h1>Invoice</h1>
        <div class="subtitle">{!invoice.Name}</div>

        <table class="meta-table">
          <tr>
            <td class="meta-label">Customer</td>
            <td>{!invoice.Customer__r.Name}</td>
          </tr>
          <tr>
            <td class="meta-label">Opportunity</td>
            <td>{!invoice.Opportunity__r.Name}</td>
          </tr>
          <tr>
            <td class="meta-label">Status</td>
            <td>{!invoice.Status__c}</td>
          </tr>
        </table>

        <h2>Line Items</h2>
        <table class="line-items">
          <thead>
            <tr>
              <th>Product</th>
              <th>Quantity</th>
              <th>Unit Price</th>
              <th>Line Total</th>
            </tr>
          </thead>
          <tbody>
            <apex:repeat value="{!lineItems}" var="item">
              <tr>
                <td>{!item.Product_Name__c}</td>
                <td>{!item.Quantity__c}</td>
                <td>{!item.Unit_Price__c}</td>
                <td>{!item.Line_Total__c}</td>
              </tr>
            </apex:repeat>
          </tbody>
        </table>

        <div class="total-row">Grand Total: {!invoice.Total_Amount__c}</div>
      </apex:outputPanel>

      <apex:outputPanel rendered="{!!hasInvoice}">
        <p class="empty-message">
          Invoice not found. Provide a valid invoice Id.
        </p>
      </apex:outputPanel>
    </body>
  </html>
</apex:page>
